---
import Inner from "../layouts/Inner.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Inner>
    <div id="resume">
      <div class="sidebar">
        <div>
          <p>Occupation: Full-stack developer</p>
          <p>Languages: Polish, English, Lithuanian, Russian</p>
          <p>Location: Warsaw, Poland</p>
          <p>
            Website: <a href="https://styx.gay">styx.gay</a>
          </p>
          <p>Email: contact@styx.gay</p>
        </div>
        <div class="skills">
          <p>
            <strong>SKILLS</strong>
          </p>
          <ul>
            <li>JS/TS/CSS/HTML</li>
            <li>Svelte</li>
            <li>Astro</li>
            <li>Rust</li>
            <li>SQL</li>
          </ul>
        </div>
      </div>
      <div>
        <div>
          <h3>App developer</h3>
          <p>@ Grupa Filmowa sp. z o.o.</p>
          <p>December 2023 - Current</p>
          <ul>
            <li>
              Designed and developed several apps relating to video production,
              utilizing Tauri for faster development and GPUI for higher
              performance.
            </li>
            <li>
              Helped increase productivity by creating proprietary applications
              that indexed a large internal archive, increasing the findability
              of video material.
            </li>
            <li>
              Introduced AI-accelerated workflows, easing the production process
              and reducing the manpower spent on tedious tasks.
            </li>
            <li>
              Worked closely with the end users and implemented rapid changes to
              quickly implement wanted features, leading to high satisfaction.
            </li>
            <li>Managed the network and local systems and servers.</li>
          </ul>
        </div>
        <div>
          <h3>Full-stack developer</h3>
          <p>@ ViviTC</p>
          <p>October 2022 - November 2023</p>
          <ul>
            <li>
              Spearheaded work on the "notki" Content Management System for
              Grupa Filmowa sp. z o.o.
            </li>
            <li>
              Designed and developed accessible user interfaces with modern
              state of the art technologies.
            </li>
            <li>
              Developed high-performance, resilient backend webservers in Rust,
              integrating containerization in Docker, and AI tools like OpenAI's
              Whisper.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Inner>
</Layout>

<style>
  #resume {
    display: flex;
    margin: 0 1rem;
  }

  @media (max-width: 740px) {
    #resume {
      flex-direction: column;
    }
  }

  ul {
    margin-top: 0;
    max-width: 800px;
    list-style: circle;
  }

  .skills {
    margin-top: 1rem;
  }
</style>
