---
import Inner from "../layouts/Inner.astro";
import Layout from "../layouts/Layout.astro";

const projects: { href?: string; label: string; description: string }[] = [
  {
    label: 'notki v3 | "docu-buddy"',
    description:
      "Video CMS with transcoding, transcribing, OCR, and visual search. Made using GPUI and SQLite.",
  },
  {
    label: 'notki v2 | "archive-buddy"',
    description:
      "Video CMS with transcoding, transcribing and pHash duplicate detection. Made using Tauri, Svelte 5, Rust and SQLite.",
  },
  {
    label: "notki CMS",
    description: `Video CMS made with Svelte/Kit, Rust, Python and PostgreSQL.`,
  },
  {
    label: "Video Colorizer",
    description: "Proprietary AI video colorizing client made in Tauri.",
  },
  {
    href: "https://codecritic.styx.gay",
    label: "codecritic",
    description: "letterboxd for npm packages, made with Svelte/Kit.",
  },
  {
    href: "https://styxtype.styx.gay",
    label: "styxtype",
    description: "A collection and showcase of free fonts.",
  },
  {
    href: "https://github.com/styxpilled/book-buddy",
    label: "book-buddy",
    description: "An ebook reader made in GPUI.",
  },
  {
    label: "file-buddy",
    description: "A file management and clip maker app made in GPUI.",
  },
  {
    label: "image-buddy",
    description:
      "High performance image viewer written in Rust, powered by egui.",
  },
];
---

<Layout>
  <Inner>
    <div class="projects">
      <h3>Projects:</h3>
      <ul>
        {projects.map(({ href, label, description }) => (
          <li>
            <h3>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ul>
    </div>
  </Inner>
</Layout>

<style>
  .projects {
    margin-top: -3vh;
    padding-left: calc(min(40px, 5vw));
  }

  ul {
    margin-top: 0;
    padding-left: 0;
  }

  p {
    margin-left: 0;
  }
</style>
